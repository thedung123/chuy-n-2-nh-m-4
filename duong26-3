import 'package:flutter/material.dart';

void main() {
  runApp(const FintechProfessionalApp());
}

class FintechProfessionalApp extends StatelessWidget {
  const FintechProfessionalApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        useMaterial3: true,
        fontFamily: 'SF Pro Display', // Font chuẩn cao cấp (mặc định Roboto trên DartPad)
        colorScheme: ColorScheme.fromSeed(
          seedColor: const Color(0xFF0A84FF), // Blue điện tử
          primary: const Color(0xFF0052CC),
          secondary: const Color(0xFF172B4D),
        ),
      ),
      home: const ProCalculatorScreen(),
    );
  }
}

class ProCalculatorScreen extends StatefulWidget {
  const ProCalculatorScreen({super.key});

  @override
  State<ProCalculatorScreen> createState() => _ProCalculatorScreenState();
}

class _ProCalculatorScreenState extends State<ProCalculatorScreen> {
  final _rateController = TextEditingController();
  String _years = "0.0";

  void _onCalculate() {
    final double? rate = double.tryParse(_rateController.text);
    setState(() {
      if (rate != null && rate > 0) {
        _years = (72 / rate).toStringAsFixed(1);
      } else {
        _years = "0.0";
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFFF4F7FA), // Màu nền xám sứ cực sang
      appBar: AppBar(
        title: const Text("FINANCIAL TOOLS", 
          style: TextStyle(fontWeight: FontWeight.w900, fontSize: 13, letterSpacing: 2, color: Color(0xFF6B778C))),
        centerTitle: true,
        backgroundColor: Colors.transparent,
        elevation: 0,
      ),
      body: SingleChildScrollView(
        child: Padding(
          padding: const EdgeInsets.symmetric(horizontal: 24.0),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const SizedBox(height: 10),
              const Text("Dự toán", style: TextStyle(fontSize: 16, color: Color(0xFF0052CC), fontWeight: FontWeight.w600)),
              const Text("Tăng trưởng tài sản", 
                style: TextStyle(fontSize: 32, fontWeight: FontWeight.bold, color: Color(0xFF172B4D), height: 1.1)),
              const SizedBox(height: 30),

              // Card nhập liệu tinh tế
              Container(
                decoration: BoxDecoration(
                  color: Colors.white,
                  borderRadius: BorderRadius.circular(24),
                  boxShadow: [
                    BoxShadow(color: Colors.black.withOpacity(0.04), blurRadius: 24, offset: const Offset(0, 12)),
                  ],
                ),
                child: Column(
                  children: [
                    _buildInputRow("Vốn đầu tư ban đầu", "đ", Icons.account_balance_rounded, null),
                    Divider(height: 1, color: Colors.grey.shade100, indent: 20, endIndent: 20),
                    _buildInputRow("Lãi suất kỳ vọng / năm", "%", Icons.insights_rounded, _rateController),
                  ],
                ),
              ),

              const SizedBox(height: 40),

              // Khu vực hiển thị kết quả "Hero"
              Center(
                child: Column(
                  children: [
                    const Text("Thời gian để tài sản của bạn gấp đôi", 
                      style: TextStyle(color: Color(0xFF6B778C), fontSize: 14, fontWeight: FontWeight.w500)),
                    const SizedBox(height: 10),
                    Container(
                      padding: const EdgeInsets.symmetric(horizontal: 40, vertical: 20),
                      decoration: BoxDecoration(
                        color: const Color(0xFF172B4D), // Xanh đậm chuyên nghiệp
                        borderRadius: BorderRadius.circular(100), // Bo tròn cực đại (Pill shape)
                      ),
                      child: Row(
                        mainAxisSize: MainAxisSize.min,
                        children: [
                          Text(_years, 
                            style: const TextStyle(fontSize: 54, fontWeight: FontWeight.w800, color: Colors.white, letterSpacing: -2)),
                          const SizedBox(width: 12),
                          const Text("NĂM", 
                            style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold, color: Color(0xFF0A84FF))),
                        ],
                      ),
                    ),
                  ],
                ),
              ),

              const SizedBox(height: 50),

              // Nút hành động phong cách tối giản (Minimalist Action)
              SizedBox(
                width: double.infinity,
                height: 64,
                child: ElevatedButton(
                  onPressed: _onCalculate,
                  style: ElevatedButton.styleFrom(
                    backgroundColor: const Color(0xFF0052CC),
                    foregroundColor: Colors.white,
                    elevation: 8,
                    shadowColor: const Color(0xFF0052CC).withOpacity(0.4),
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(18)),
                  ),
                  child: const Text("PHÂN TÍCH NGAY", 
                    style: TextStyle(fontSize: 16, fontWeight: FontWeight.w800, letterSpacing: 1.5)),
                ),
              ),
              
              const SizedBox(height: 30),
              Center(
                child: Text("Số liệu tính toán dựa trên thuật toán lãi kép quốc tế", 
                  style: TextStyle(color: Colors.grey.shade500, fontSize: 11)),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildInputRow(String label, String unit, IconData icon, TextEditingController? controller) {
    return Padding(
      padding: const EdgeInsets.all(24.0),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Icon(icon, size: 18, color: const Color(0xFF6B778C)),
              const SizedBox(width: 8),
              Text(label.toUpperCase(), 
                style: const TextStyle(fontSize: 11, fontWeight: FontWeight.w800, color: Color(0xFF6B778C), letterSpacing: 1)),
            ],
          ),
          TextField(
            controller: controller,
            keyboardType: TextInputType.number,
            style: const TextStyle(fontSize: 22, fontWeight: FontWeight.bold, color: Color(0xFF172B4D)),
            decoration: InputDecoration(
              hintText: "Nhập số liệu",
              hintStyle: TextStyle(color: Colors.grey.shade300, fontSize: 20),
              suffixText: unit,
              suffixStyle: const TextStyle(color: Color(0xFF172B4D), fontWeight: FontWeight.bold),
              border: InputBorder.none,
              contentPadding: const EdgeInsets.only(top: 8),
            ),
          ),
        ],
      ),
    );
  }
}
